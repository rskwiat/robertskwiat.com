<form id="contact-form" class="stack">
  <label>
    Name
    <input name="name" required />
  </label>

  <label>
    Email
    <input type="email" name="email" required />
  </label>

  <label>
    Message
    <textarea name="message" required></textarea>
  </label>

  <button type="submit">Send</button>
  <p id="form-status" aria-live="polite"></p>
</form>