<!doctype html>
<html lang="en">
  {% include "components/head.njk" %}

  <body>
    <main>
      <nav class="navbar">
          <ul>
    {% for item in settings.navigation %}
      <li>
        <a href="{{ item.url }}" data-scroll-to="{{ item.dataScrollTo }}">
            <span class="tooltip">{{ item.title }}</span>
        </a>
      </li>
    {% endfor %}
  </ul>
        {% include "components/dark-mode.njk" %}
      </nav>
      <div class="container">
        {{ content | safe }}

        {% include "components/see-more.njk" %}
      </div>

      {% include "components/footer.njk" %}
    </main>
  </body>
  {% include "components/scripts.njk" %}

</html>
